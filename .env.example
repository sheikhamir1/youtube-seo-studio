# ---------------------------------------------------------------------------
# YouTube SEO Studio - environment configuration
# Copy to .env and adjust. Never commit the real .env file.
# ---------------------------------------------------------------------------

# Application
APP_ENV=development
APP_NAME=YouTube SEO Studio
API_V1_PREFIX=/api/v1
LOG_LEVEL=INFO

# Database -------------------------------------------------------------------
# Host (native backend) development connection:
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5430/youtube_seo_studio
# Inside Docker Compose the hostname is "postgres", not "localhost" - see
# docker-compose.yml, which overrides DATABASE_URL for the backend service.
POSTGRES_DB=youtube_seo_studio
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5430

# Gemini (AI) ---------------------------------------------------------------
# AI_PROVIDER=gemini (real) | mock (deterministic offline client for tests)
AI_PROVIDER=gemini
GEMINI_API_KEY=your-api-key-here
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_ALLOWED_MODELS=gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-3.8-flash,gemini-3.7-flash,gemini-3.6-flash,gemini-3.5-flash
GEMINI_RPM_LIMIT=15
GEMINI_TPM_LIMIT=250000
GEMINI_RPD_LIMIT=500
GEMINI_MIN_INTERVAL_SECONDS=60
GEMINI_MAX_CONCURRENCY=1
AUDIO_TOKENS_PER_SECOND=32
MAP_THINKING_LEVEL=high
REDUCE_THINKING_LEVEL=high
MAX_GEMINI_RETRIES=8
MAX_SCHEMA_REPAIR_ATTEMPTS=2

# Processing -----------------------------------------------------------------
CHUNK_DURATION_SECONDS=3600
CHUNK_OVERLAP_SECONDS=60
MAP_MAX_TOPICS_PER_CHUNK=20
AUDIO_FORMAT=flac
MAX_SAFE_INPUT_TOKENS=180000
TIMELINE_SIMILARITY_THRESHOLD=0.88
REDUCE_SAFE_INPUT_TOKENS=180000
WORKER_POLL_INTERVAL_SECONDS=1.5
WORKER_STALE_SECONDS=120
UPLOAD_PART_SIZE_MB=32
STALE_UPLOAD_HOURS=24

# Storage --------------------------------------------------------------------
# Native development default. Docker overrides this with /app/data.
DATA_DIR=./data

# Web ------------------------------------------------------------------------
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
VITE_API_BASE_URL=http://localhost:8000/api/v1
FRONTEND_PORT=8080
BACKEND_PORT=8000

# YouTube Publisher -----------------------------------------------------------
YOUTUBE_REDIRECT_URI=http://localhost:8000/api/v1/youtube/auth/callback
YOUTUBE_FRONTEND_URL=http://localhost:8080
